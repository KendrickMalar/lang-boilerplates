{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.cts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "tests/**/*.cts",
    "vitest.config.ts",
    "vitest.config.mts",
    "vitest.config.cts"
  ]
}
