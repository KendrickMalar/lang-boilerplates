{
  "name": "typescript-web-game-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "jscpd": "5.4.1",
    "oxc-parser": "0.73.2",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "vite": "8.3.4",
    "@types/node": "24.19.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-regexp": "3.3.1",
    "@types/three": "0.186.0",
    "@playwright/test": "1.64.1",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-import-resolver-typescript": "4.4.5"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:duplicates": "node check-duplicates.mjs",
    "lint:similarity": "node check-similarity.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:duplicates && pnpm lint:similarity && pnpm format:check && pnpm test && pnpm test:e2e:preview",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:preview": "pnpm build && playwright test --config playwright.preview.config.ts"
  },
  "dependencies": {
    "three": "0.186.1",
    "@dimforge/rapier3d-compat": "0.21.0"
  }
}
