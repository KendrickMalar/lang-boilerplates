{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Native App",
  "version": "0.1.0",
  "identifier": "com.example.native-app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Native App" }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
