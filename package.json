{
  "name": "lang-boilerplates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test:static": "node --test tests/common.test.mjs tests/readme.test.mjs tests/node-support.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/node.test.mjs tests/web.test.mjs tests/library.test.mjs tests/hooks.test.mjs tests/strict-lint.test.mjs",
    "test": "node --version && pnpm test:static && pnpm test:integration",
    "test:native:quality": "python3 -m tests.native.test_catalog tests.native.test_quality_settings",
    "test:native:static": "python3 -m tests.native.test_catalog tests.native.test_catalog tests.native.test_static_rust tests.native.test_static_swift tests.native.test_static_roblox tests.native.test_static_godot tests.native.test_static_blender tests.native.test_hooks.HookContractTests",
    "test:native:rust": "python3 -m tests.native.test_catalog tests.native.test_rust tests.native.test_hooks.RustHookTests",
    "test:native:macos": "PYTHONPATH=tests/native python3 -m tests.native.test_catalog tests.native.test_swift_macos tests.native.test_hooks.MacOSHookTests",
    "test:native:roblox": "python3 -m tests.native.test_catalog tests.native.test_roblox tests.native.test_hooks.RobloxHookTests",
    "test:native:ios": "PYTHONPATH=tests/native python3 -m tests.native.test_catalog tests.native.test_swift_ios tests.native.test_hooks.IOSHookTests"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "vitest": "5.0.3",
    "vite": "8.3.4",
    "tsx": "4.23.15",
    "@types/node": "24.19.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-regexp": "3.3.1"
  }
}
